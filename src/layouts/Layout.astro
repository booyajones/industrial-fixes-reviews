---
export interface Props {
  title?: string;
  description?: string;
  schema?: string;
}

const {
  title,
  description = 'Honest, research-backed reviews of HVAC replacement parts and diagnostic tools for homeowners and technicians.',
  schema,
} = Astro.props;

const pageTitle = title
  ? `${title} | ErrorCodeFixes Reviews`
  : 'ErrorCodeFixes Reviews — HVAC Parts & Tools';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {schema && <script type="application/ld+json" set:html={schema} />}
    <style>
      body { font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
    </style>
  </head>
  <body class="bg-white text-gray-900 antialiased">

    <header class="bg-slate-900 sticky top-0 z-50 border-b border-slate-800">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="flex items-center justify-between h-14">
          <a href="/" class="font-bold text-white tracking-tight shrink-0">
            ErrorCodeFixes&thinsp;<span class="text-blue-400">Reviews</span>
          </a>
          <nav class="flex items-center gap-0.5 text-sm">
            <a href="/reviews/" class="text-slate-300 hover:text-white hover:bg-slate-800 px-3 py-1.5 rounded-md font-medium transition-colors">All Reviews</a>
            <a href="/categories/" class="text-slate-300 hover:text-white hover:bg-slate-800 px-3 py-1.5 rounded-md font-medium transition-colors">Categories</a>
            <a href="/best/" class="text-slate-300 hover:text-white hover:bg-slate-800 px-3 py-1.5 rounded-md font-medium transition-colors">Buyer's Guides</a>
            <a
              href="https://errorcodefixes.com"
              target="_blank"
              rel="noopener noreferrer"
              class="ml-2 text-slate-400 hover:text-white hover:bg-slate-800 px-3 py-1.5 rounded-md font-medium transition-colors"
            >Repair Guides ↗</a>
          </nav>
        </div>
      </div>
    </header>

    <slot />

    <footer class="bg-gray-50 border-t border-gray-200 mt-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
          <div>
            <div class="font-bold text-gray-900 mb-2">
              ErrorCodeFixes <span class="text-blue-600">Reviews</span>
            </div>
            <p class="text-sm text-gray-500 leading-relaxed">
              Honest, research-backed reviews of HVAC replacement parts for homeowners and technicians.
            </p>
          </div>
          <div>
            <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Reviews</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="/reviews/" class="text-gray-500 hover:text-blue-600 transition-colors">All Reviews</a></li>
              <li><a href="/categories/" class="text-gray-500 hover:text-blue-600 transition-colors">Browse by Category</a></li>
              <li><a href="/best/" class="text-gray-500 hover:text-blue-600 transition-colors">Buyer's Guides</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Resources</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="https://errorcodefixes.com" target="_blank" rel="noopener" class="text-gray-500 hover:text-blue-600 transition-colors">Repair Guides</a></li>
              <li><a href="https://errorcodefixes.com/hvac-error-codes/" target="_blank" rel="noopener" class="text-gray-500 hover:text-blue-600 transition-colors">HVAC Error Codes</a></li>
              <li><a href="https://errorcodefixes.com/posts/furnace-not-igniting/" target="_blank" rel="noopener" class="text-gray-500 hover:text-blue-600 transition-colors">Furnace Not Igniting</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-gray-200 pt-6">
          <p class="text-xs text-gray-400 leading-relaxed">
            <strong class="text-gray-500">Affiliate Disclosure:</strong> ErrorCodeFixes Reviews participates in the Amazon Services LLC Associates Program and earns a commission on qualifying purchases made through affiliate links. Reviews are based on manufacturer specifications, compatibility data, and research — not hands-on testing. Always verify compatibility with your specific equipment before purchasing.
          </p>
        </div>
      </div>
    </footer>

  </body>
</html>
