---
import StarRating from './StarRating.astro';
import type { ReviewData } from '../data/reviews';

export interface Props {
  review: ReviewData;
}

const { review } = Astro.props;
const { title, slug, category, brand, rating, verdict, priceRange, featured } = review;

const catNames: Record<string, string> = {
  'furnace-igniters': 'Furnace Igniters',
  'flame-sensors': 'Flame Sensors',
  'pressure-switches': 'Pressure Switches',
  'capacitors': 'Capacitors',
  'fan-motors': 'Fan Motors',
  'gas-valves': 'Gas Valves',
  'control-boards': 'Control Boards',
  'hvac-tools': 'HVAC Tools',
  'electrical': 'Electrical',
};

const ratingLabel = rating >= 4.5 ? 'Excellent' : rating >= 4.0 ? 'Very Good' : rating >= 3.5 ? 'Good' : 'Fair';
---

<a
  href={`/reviews/${slug}/`}
  class="group flex flex-col bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md hover:border-blue-200 transition-all duration-200"
>
  <div class="bg-gradient-to-br from-slate-100 to-blue-50 h-32 flex items-center justify-center px-4 shrink-0">
    <div class="text-center">
      <div class="text-xs font-semibold text-slate-500 uppercase tracking-widest mt-1">
        {catNames[category] ?? category}
      </div>
    </div>
  </div>

  <div class="p-5 flex flex-col flex-1">
    <div class="flex items-start justify-between gap-2 mb-1">
      <span class="text-xs font-semibold text-blue-600 uppercase tracking-wide">{brand}</span>
      {featured && (
        <span class="text-xs font-medium bg-blue-50 text-blue-700 px-2 py-0.5 rounded-full shrink-0">
          Featured
        </span>
      )}
    </div>

    <h3 class="text-[15px] font-semibold text-gray-900 leading-snug mb-2 group-hover:text-blue-700 transition-colors">
      {title}
    </h3>

    <div class="flex items-center gap-2 mb-3">
      <StarRating rating={rating} size="sm" />
      <span class="text-xs text-gray-500">{rating}/5 &middot; {ratingLabel}</span>
    </div>

    <p class="text-sm text-gray-600 leading-relaxed line-clamp-2 flex-1">{verdict}</p>

    <div class="flex items-center justify-between mt-4 pt-4 border-t border-gray-100">
      <span class="text-sm font-semibold text-gray-800">{priceRange}</span>
      <span class="text-sm font-medium text-blue-600 group-hover:text-blue-800 transition-colors">
        Read Review &rarr;
      </span>
    </div>
  </div>
</a>
