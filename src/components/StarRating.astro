---
export interface Props {
  rating: number;
  size?: 'sm' | 'md' | 'lg';
  showNumber?: boolean;
}

const { rating, size = 'md', showNumber = false } = Astro.props;

const sizeMap = { sm: 'w-3.5 h-3.5', md: 'w-4 h-4', lg: 'w-5 h-5' };
const cls = sizeMap[size];
const path = 'M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z';
---

<div class="flex items-center gap-0.5" aria-label={`${rating} out of 5 stars`} role="img">
  {Array.from({ length: 5 }).map((_, i) => {
    const full = rating >= i + 1;
    const half = !full && rating >= i + 0.5;
    if (full) {
      return (
        <svg class={`${cls} text-yellow-400 flex-shrink-0`} fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path d={path} />
        </svg>
      );
    } else if (half) {
      return (
        <span class={`relative inline-block ${cls} flex-shrink-0`}>
          <svg class={`${cls} text-gray-200`} fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path d={path} />
          </svg>
          <span class="absolute inset-0 overflow-hidden w-1/2">
            <svg class={`${cls} text-yellow-400`} fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path d={path} />
            </svg>
          </span>
        </span>
      );
    } else {
      return (
        <svg class={`${cls} text-gray-200 flex-shrink-0`} fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path d={path} />
        </svg>
      );
    }
  })}
  {showNumber && <span class="ml-1.5 text-sm font-medium text-gray-600">{rating}</span>}
</div>
