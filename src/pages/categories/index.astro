---
import Layout from '../../layouts/Layout.astro';
import { reviews } from '../../data/reviews';
---

<Layout title="Categories">
  <main class="max-w-6xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Categories</h1>
    <p class="text-gray-600 mb-8">Browse HVAC product reviews by category.</p>
    
    <div class="space-y-10">
      {Array.from(new Set(reviews.map(r => r.category))).map(cat => {
        const catReviews = reviews.filter(r => r.category === cat);
        const catName = cat.replace(/-/g, ' ').replace(/\b\w/g, (s: string) => s.toUpperCase());
        return (
          <section>
            <h2 class="text-2xl font-semibold text-gray-800 mb-4 capitalize">{catName}</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {catReviews.map(r => (
                <a href={`/reviews/${r.slug}/`} class="p-4 border rounded-lg hover:bg-gray-50 transition">
                  <h3 class="font-semibold text-gray-900">{r.title}</h3>
                  <p class="text-sm text-gray-600 mt-1">{r.verdict}</p>
                  <span class="text-sm font-medium text-blue-600 mt-2 inline-block">Read Review →</span>
                </a>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </main>
</Layout>
