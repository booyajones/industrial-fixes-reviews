---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Buyer's Guides">
  <main class="max-w-6xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Buyer's Guides</h1>
    <p class="text-gray-600 mb-8">Research-backed buying guides for HVAC replacement parts.</p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <a href="/best/furnace-igniters/" class="block p-6 bg-white border rounded-lg hover:shadow-md">
        <h2 class="text-xl font-semibold text-gray-900">Best Furnace Igniters 2026</h2>
        <p class="text-gray-600 mt-2">Compare the top 5 hot surface igniters for your furnace replacement.</p>
      </a>
      <a href="/best/flame-sensors/" class="block p-6 bg-white border rounded-lg hover:shadow-md">
        <h2 class="text-xl font-semibold text-gray-900">Best Flame Sensors for HVAC</h2>
        <p class="text-gray-600 mt-2">Find the right flame sensor for your furnace make and model.</p>
      </a>
      <a href="/best/hvac-tools/" class="block p-6 bg-white border rounded-lg hover:shadow-md">
        <h2 class="text-xl font-semibold text-gray-900">Essential HVAC Diagnostic Tools</h2>
        <p class="text-gray-600 mt-2">Multimeters, manometers, and tools every DIYer should own.</p>
      </a>
    </div>
  </main>
</Layout>
