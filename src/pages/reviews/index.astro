---
import Layout from '../../layouts/Layout.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import { reviews } from '../../data/reviews';

const catNames: Record<string, string> = {
  'furnace-igniters': 'Furnace Igniters',
  'flame-sensors': 'Flame Sensors',
  'pressure-switches': 'Pressure Switches',
  'capacitors': 'Capacitors',
  'fan-motors': 'Fan Motors',
  'gas-valves': 'Gas Valves',
  'control-boards': 'Control Boards',
  'hvac-tools': 'HVAC Tools',
  'electrical': 'Electrical',
};

const categories = Array.from(new Set(reviews.map((r) => r.category)));
---

<Layout
  title="All Product Reviews"
  description="Browse all HVAC replacement part reviews — igniters, flame sensors, capacitors, motors, gas valves, and more."
>
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-10">

    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-400 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-blue-600 transition-colors">Home</a>
      <span class="mx-2">/</span>
      <span class="text-gray-700 font-medium">All Reviews</span>
    </nav>

    <div class="mb-10">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">All Product Reviews</h1>
      <p class="text-gray-500 text-base">
        {reviews.length} reviews of HVAC replacement parts, verified against manufacturer specifications.
      </p>
    </div>

    <div class="space-y-14">
      {categories.map((cat) => {
        const catReviews = reviews.filter((r) => r.category === cat);
        const label = catNames[cat] ?? cat;
        return (
          <section id={cat}>
            <div class="flex items-baseline justify-between mb-5">
              <h2 class="text-xl font-bold text-gray-900">{label}</h2>
              <span class="text-sm text-gray-400">{catReviews.length} {catReviews.length === 1 ? 'review' : 'reviews'}</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
              {catReviews.map((review) => (
                <ReviewCard review={review} />
              ))}
            </div>
          </section>
        );
      })}
    </div>

  </main>
</Layout>
