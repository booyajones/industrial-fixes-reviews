---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="All Product Reviews">
  <main class="max-w-6xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">All Product Reviews</h1>
    <p class="text-gray-600 mb-8">Research-backed reviews of HVAC replacement parts and tools.</p>

    <div class="space-y-8">
      <section>
        <h2 class="text-xl font-semibold text-gray-800 mb-4">Furnace Parts</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <a href="/reviews/honeywell-hot-surface-igniter-q4100c/" class="p-4 border rounded-lg hover:bg-gray-50">
            <h3 class="font-semibold">Honeywell Hot Surface Igniter Q4100C</h3>
            <p class="text-sm text-gray-600 mt-1">OEM replacement for Lennox, Goodman, Carrier</p>
          </a>
          <a href="/reviews/universal-flame-sensor-rod/" class="p-4 border rounded-lg hover:bg-gray-50">
            <h3 class="font-semibold">Universal Flame Sensor Rod</h3>
            <p class="text-sm text-gray-600 mt-1">Budget-friendly flame sensor for most brands</p>
          </a>
          <a href="/reviews/white-rodgers-gas-valve-36e22/" class="p-4 border rounded-lg hover:bg-gray-50">
            <h3 class="font-semibold">White-Rodgers Gas Valve 36E22</h3>
            <p class="text-sm text-gray-600 mt-1">Direct-fit residential gas valve</p>
          </a>
        </div>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-gray-800 mb-4">Electrical Components</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <a href="/reviews/supco-run-capacitor-45-5-mfd/" class="p-4 border rounded-lg hover:bg-gray-50">
            <h3 class="font-semibold">Supco Run Capacitor 45+5 MFD</h3>
            <p class="text-sm text-gray-600 mt-1">Consistent ratings, solid HVAC replacement</p>
          </a>
          <a href="/reviews/supco-compressor-contactor/" class="p-4 border rounded-lg hover:bg-gray-50">
            <h3 class="font-semibold">Supco Compressor Contactor</h3>
            <p class="text-sm text-gray-600 mt-1">Reliable 2-pole contactor for AC compressors</p>
          </a>
          <a href="/reviews/honeywell-furnace-thermocouple/" class="p-4 border rounded-lg hover:bg-gray-50">
            <h3 class="font-semibold">Honeywell Furnace Thermocouple</h3>
            <p class="text-sm text-gray-600 mt-1">Standard replacement for standing pilot systems</p>
          </a>
        </div>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-gray-800 mb-4">Motors & Mechanical</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <a href="/reviews/emerson-condenser-fan-motor-k55hx/" class="p-4 border rounded-lg hover:bg-gray-50">
            <h3 class="font-semibold">Emerson Condenser Fan Motor K55HX</h3>
            <p class="text-sm text-gray-600 mt-1">Universal replacement for AC condenser units</p>
          </a>
          <a href="/reviews/fasco-inducer-motor-assembly/" class="p-4 border rounded-lg hover:bg-gray-50">
            <h3 class="font-semibold">Fasco Inducer Motor Assembly</h3>
            <p class="text-sm text-gray-600 mt-1">Precision fit for furnace inducer applications</p>
          </a>
          <a href="/reviews/honeywell-pressure-switch/" class="p-4 border rounded-lg hover:bg-gray-50">
            <h3 class="font-semibold">Honeywell Pressure Switch</h3>
            <p class="text-sm text-gray-600 mt-1">Standard pressure switch for gas furnaces</p>
          </a>
        </div>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-gray-800 mb-4">Tools & Accessories</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <a href="/reviews/diversitech-pressure-switch-hose/" class="p-4 border rounded-lg hover:bg-gray-50">
            <h3 class="font-semibold">Diversitech Pressure Switch Hose Kit</h3>
            <p class="text-sm text-gray-600 mt-1">Replacement tubing for pressure switch lines</p>
          </a>
          <a href="/reviews/honeywell-high-pressure-switch/" class="p-4 border rounded-lg hover:bg-gray-50">
            <h3 class="font-semibold">Honeywell High Pressure Switch</h3>
            <p class="text-sm text-gray-600 mt-1">High-limit pressure switch for specific applications</p>
          </a>
          <a href="/reviews/universal-furnace-control-board/" class="p-4 border rounded-lg hover:bg-gray-50">
            <h3 class="font-semibold">Universal Furnace Control Board</h3>
            <p class="text-sm text-gray-600 mt-1">Replacement IFC board for multiple brands</p>
          </a>
        </div>
      </section>
    </div>
  </main>
</Layout>
