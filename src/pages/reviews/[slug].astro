---
import Layout from '../../layouts/Layout.astro';
import StarRating from '../../components/StarRating.astro';
import FTCNotice from '../../components/FTCNotice.astro';
import { reviews } from '../../data/reviews';

export function getStaticPaths() {
  return reviews.map((review) => ({
    params: { slug: review.slug },
    props: { review },
  }));
}

export interface Props {
  review: typeof reviews[0];
}

const { review } = Astro.props;
---

<Layout title={review.title}>
  <main class="max-w-4xl mx-auto px-4 py-8">
    <nav class="text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-blue-600">Home</a>
      <span class="mx-2">/</span>
      <a href="/reviews/" class="hover:text-blue-600">Reviews</a>
      <span class="mx-2">/</span>
      <a href={`/categories/${review.category}/`} class="hover:text-blue-600 capitalize">{review.category.replace(/-/g, ' ')}</a>
      <span class="mx-2">/</span>
      <span class="text-gray-800">{review.title}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-10">
      <div class="lg:col-span-2">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-sm font-medium text-blue-600 uppercase tracking-wide">{review.brand}</span>
        </div>
        <h1 class="text-3xl font-bold text-gray-900 mb-3">{review.title}</h1>
        <div class="flex items-center gap-3 mb-4">
          <StarRating rating={review.rating} size="lg" />
          <span class="text-lg font-medium text-gray-700">{review.rating}/5</span>
        </div>
        <p class="text-lg text-gray-700 mb-4 leading-relaxed">{review.verdict}</p>
        <p class="text-2xl font-bold text-gray-900 mb-6">{review.priceRange}</p>
        <a href={review.affiliateUrl} target="_blank" rel="nofollow sponsored" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold px-8 py-3 rounded-lg transition-colors mb-8">
          Check Price on Amazon →
        </a>
      </div>
      <div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
        <h2 class="font-semibold text-gray-800 mb-3">Quick Specs</h2>
        <dl class="space-y-3 text-sm">
          <div><dt class="text-gray-500">Brand</dt><dd class="font-medium">{review.brand}</dd></div>
          <div><dt class="text-gray-500">Category</dt><dd class="font-medium capitalize">{review.category.replace(/-/g, ' ')}</dd></div>
          <div><dt class="text-gray-500">Price Range</dt><dd class="font-medium">{review.priceRange}</dd></div>
          <div><dt class="text-gray-500">ASIN</dt><dd class="font-mono text-xs">{review.asin}</dd></div>
        </dl>
      </div>
    </div>

    <div class="prose max-w-none mb-10">
      <h2>Overview</h2>
      <p>{review.description}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">
      <div class="bg-green-50 border border-green-200 rounded-lg p-6">
        <h2 class="text-lg font-semibold text-green-800 mb-3">Pros</h2>
        <ul class="space-y-2">
          {review.pros.map(pro => (
            <li class="flex items-start gap-2 text-green-900">
              <span class="text-green-600 mt-0.5">✓</span>
              <span>{pro}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="bg-red-50 border border-red-200 rounded-lg p-6">
        <h2 class="text-lg font-semibold text-red-800 mb-3">Cons</h2>
        <ul class="space-y-2">
          {review.cons.map(con => (
            <li class="flex items-start gap-2 text-red-900">
              <span class="text-red-600 mt-0.5">✗</span>
              <span>{con}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mb-10">
      <h2 class="text-xl font-semibold text-gray-800 mb-3">Who It's For</h2>
      <p class="text-gray-700 leading-relaxed">{review.whoItsFor}</p>
    </div>

    <div class="mb-10 p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
      <h2 class="text-lg font-semibold text-yellow-800 mb-2">Who Should Skip This</h2>
      <p class="text-yellow-900 leading-relaxed">{review.whoShouldSkip}</p>
    </div>

    <div class="mb-10">
      <h2 class="text-xl font-semibold text-gray-800 mb-3">Compatibility</h2>
      <p class="text-gray-700 leading-relaxed">{review.compatibility}</p>
    </div>

    {review.repairGuideUrl && (
      <div class="mb-10 p-4 bg-blue-50 border border-blue-200 rounded-lg">
        <h2 class="text-lg font-semibold text-blue-800 mb-2">Related Repair Guide</h2>
        <p class="text-blue-900 mb-2">This part is referenced in our main repair guide:</p>
        <a href={review.repairGuideUrl} target="_blank" class="text-blue-600 hover:underline font-medium">View the full diagnostic guide on errorcodefixes.com →</a>
      </div>
    )}

    <div class="border-t border-gray-200 pt-8 mb-10">
      <h2 class="text-xl font-semibold text-gray-800 mb-3">Bottom Line</h2>
      <p class="text-gray-700 leading-relaxed text-lg">{review.bottomLine}</p>
    </div>

    <div class="text-center my-8">
      <a href={review.affiliateUrl} target="_blank" rel="nofollow sponsored" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold px-10 py-4 rounded-lg text-lg transition-colors">
        Check Latest Price on Amazon
      </a>
    </div>

    <FTCNotice />
  </main>
</Layout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": review.title,
  "image": review.image,
  "description": review.verdict,
  "brand": { "@type": "Brand", "name": review.brand },
  "offers": { "@type": "Offer", "url": review.affiliateUrl, "priceCurrency": "USD", "availability": "https://schema.org/InStock" },
  "review": {
    "@type": "Review",
    "reviewRating": { "@type": "Rating", "ratingValue": review.rating, "bestRating": "5" },
    "author": { "@type": "Organization", "name": "ErrorCodeFixes Reviews" }
  }
})} />
